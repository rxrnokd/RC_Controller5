<?xml version="1.0"?>
<package format="3">
  <name>rc_car</name><version>0.1.0</version>
  <description>Fail-closed RC vehicle control, encoder odometry and local WebSocket UI.</description>
  <maintainer email="maintainer@example.invalid">RC Car Maintainer</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>slam_toolbox</exec_depend><exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend><exec_depend>rtabmap_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend><exec_depend>python3-aiohttp</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
